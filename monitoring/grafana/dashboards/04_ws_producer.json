{
  "description": "WebSocket Producer - Massive.com API → Kafka",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 400,
      "title": "🔌 Connection Status",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DISCONNECTED", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "CONNECTED", "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 401,
      "title": "WS Connection (Second)",
      "type": "stat",
      "options": { "colorMode": "background" },
      "targets": [
        { "expr": "ws_producer_connection_state{stream_type=\"second\"}", "legendFormat": "Second" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DISCONNECTED", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "CONNECTED", "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 402,
      "title": "WS Connection (Minute)",
      "type": "stat",
      "options": { "colorMode": "background" },
      "targets": [
        { "expr": "ws_producer_connection_state{stream_type=\"minute\"}", "legendFormat": "Minute" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 403,
      "title": "Subscribed Tickers",
      "type": "stat",
      "targets": [
        { "expr": "sum(ws_producer_subscribed_tickers)", "legendFormat": "Tickers" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 404,
      "title": "Total Reconnections",
      "type": "stat",
      "targets": [
        { "expr": "sum(ws_producer_reconnections_total)", "legendFormat": "Reconnects" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 405,
      "title": "Kafka Queue Size",
      "type": "stat",
      "targets": [
        { "expr": "ws_producer_kafka_queue_size", "legendFormat": "Queue" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.90 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "max": 1, "min": 0
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 406,
      "title": "Parse Validity Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(ws_producer_aggregates_parsed_total[5m])) / (sum(rate(ws_producer_aggregates_parsed_total[5m])) + sum(rate(ws_producer_aggregates_invalid_total[5m])) + 0.001)",
          "legendFormat": "Validity"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 410,
      "title": "📊 Message Throughput",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25, "gradientMode": "scheme" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 411,
      "title": "📥 WS Messages Received (per second)",
      "type": "timeseries",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "expr": "rate(ws_producer_messages_received_total[30s])",
          "legendFormat": "{{stream_type}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 412,
      "title": "📤 Kafka Messages Produced (per second)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(ws_producer_kafka_messages_produced_total[30s])",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 413,
      "title": "⏱️ Message Processing Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(ws_producer_message_processing_seconds_bucket[5m]))",
          "legendFormat": "p50 {{stream_type}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(ws_producer_message_processing_seconds_bucket[5m]))",
          "legendFormat": "p95 {{stream_type}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(ws_producer_message_processing_seconds_bucket[5m]))",
          "legendFormat": "p99 {{stream_type}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 414,
      "title": "⏱️ Kafka Produce Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(ws_producer_kafka_produce_latency_seconds_bucket[5m]))",
          "legendFormat": "p50 {{topic}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(ws_producer_kafka_produce_latency_seconds_bucket[5m]))",
          "legendFormat": "p99 {{topic}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 420,
      "title": "📈 Top Symbols by Volume",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "id": 421,
      "title": "Top 20 Symbols by Message Count (Last 5 min)",
      "type": "bargauge",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "topk(20, increase(ws_producer_aggregates_parsed_total{stream_type=\"second\"}[5m]))",
          "legendFormat": "{{symbol}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["stock-platform", "ws-producer"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "🔌 WebSocket Producer",
  "uid": "ws-producer",
  "version": 1
}
