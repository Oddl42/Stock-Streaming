{
  "description": "Apache Kafka Broker, Topics & Consumer Group Monitoring",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "🔴 Kafka Broker Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 201,
      "title": "Brokers Online",
      "type": "stat",
      "targets": [
        {
          "expr": "count(up{job=\"kafka\"} == 1)",
          "legendFormat": "Brokers"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 202,
      "title": "Under-Replicated Partitions",
      "type": "stat",
      "targets": [
        {
          "expr": "kafka_server_replicamanager_underreplicatedpartitions",
          "legendFormat": "Under-replicated"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 203,
      "title": "Active Controllers",
      "type": "stat",
      "targets": [
        {
          "expr": "kafka_controller_kafkacontroller_activecontrollercount",
          "legendFormat": "Controllers"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 204,
      "title": "Offline Partitions",
      "type": "stat",
      "targets": [
        {
          "expr": "kafka_controller_kafkacontroller_offlinepartitionscount",
          "legendFormat": "Offline"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 205,
      "title": "Log Size Total",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kafka_log_log_size)",
          "legendFormat": "Total Log Size"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 206,
      "title": "Total Partitions",
      "type": "stat",
      "targets": [
        {
          "expr": "kafka_server_replicamanager_partitioncount",
          "legendFormat": "Partitions"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 210,
      "title": "📊 Topic Throughput",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25, "gradientMode": "scheme" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 211,
      "title": "📥 Messages In (per Topic)",
      "type": "timeseries",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "expr": "rate(kafka_server_brokertopicmetrics_messagesinpersec_count{topic=~\"stocks.*\"}[1m])",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 212,
      "title": "📤 Bytes In/Out (per Topic)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(kafka_server_brokertopicmetrics_bytesinpersec_count{topic=~\"stocks.*\"}[1m])",
          "legendFormat": "In: {{topic}}"
        },
        {
          "expr": "rate(kafka_server_brokertopicmetrics_bytesoutpersec_count{topic=~\"stocks.*\"}[1m])",
          "legendFormat": "Out: {{topic}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 220,
      "title": "⏱️ Consumer Lag",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 221,
      "title": "Consumer Lag (Second Stream)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{topic=\"stocks.aggregates.second\"}",
          "legendFormat": "Partition {{partition}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 222,
      "title": "Consumer Lag (Minute Stream)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{topic=\"stocks.aggregates.minute\"}",
          "legendFormat": "Partition {{partition}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 230,
      "title": "💾 Broker Resources",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 231,
      "title": "Request Latency (Produce)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafka_network_requestmetrics_totaltimems{request=\"Produce\",quantile=\"0.99\"}",
          "legendFormat": "p99 Produce"
        },
        {
          "expr": "kafka_network_requestmetrics_totaltimems{request=\"Produce\",quantile=\"0.50\"}",
          "legendFormat": "p50 Produce"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 232,
      "title": "Request Latency (Fetch / Consumer)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafka_network_requestmetrics_totaltimems{request=\"FetchConsumer\",quantile=\"0.99\"}",
          "legendFormat": "p99 FetchConsumer"
        },
        {
          "expr": "kafka_network_requestmetrics_totaltimems{request=\"FetchConsumer\",quantile=\"0.50\"}",
          "legendFormat": "p50 FetchConsumer"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["stock-platform", "kafka"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "🔴 Kafka Monitoring",
  "uid": "kafka-monitoring",
  "version": 1
}
