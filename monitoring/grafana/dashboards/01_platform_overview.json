      "targets": [
        {
          "expr": "rate(ws_producer_messages_received_total[1m])",
          "legendFormat": "{{stream_type}} msg/s"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
