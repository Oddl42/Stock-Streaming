      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "ws_producer_subscribed_tickers",
          "legendFormat": "{{stream_type}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "id": 14,
      "title": "❌ Errors & Rejections",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(spark_streaming_records_rejected_total[5m])",
          "legendFormat": "Rejected: {{stream_type}}"
        },
        {
          "expr": "rate(ws_producer_kafka_produce_errors_total[5m])",
          "legendFormat": "Kafka Errors: {{topic}}"
        },
        {
          "expr": "rate(spark_streaming_write_errors_total[5m])",
          "legendFormat": "DB Write Errors: {{stream_type}}"
        }
      ]
    },
