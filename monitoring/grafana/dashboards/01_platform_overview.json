      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) as value FROM stock_agg_second;",
          "format": "table"
        }
      ]
    },
    {
      "datasource": "TimescaleDB",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 23 },
      "id": 21,
      "title": "📦 Rows: stock_agg_minute",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "purple", "value": null }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) as value FROM stock_agg_minute;",
          "format": "table"
        }
      ]
    },
    {
      "datasource": "TimescaleDB",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 23 },
      "id": 22,
      "title": "📋 Unique Symbols (Second)",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "orange", "value": null }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT count(DISTINCT symbol) as value FROM stock_agg_second WHERE time > NOW() - INTERVAL '1 hour';",
          "format": "table"
        }
      ]
    },
    {
      "datasource": "TimescaleDB",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 23 },
      "id": 23,
      "title": "💀 Dead Letter Queue",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) as value FROM dead_letter_queue WHERE rejected_at > NOW() - INTERVAL '1 hour';",
          "format": "table"
        }
      ]
    },
    {
      "datasource": "TimescaleDB",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "id": 24,
      "title": "📈 Ingest Rate (Rows per Minute)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 70 }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, count(*) AS value FROM stock_agg_second WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1;",
          "format": "time_series"
        }
      ]
    }
