{
  "description": "TimescaleDB / PostgreSQL Performance & Data Monitoring",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 500,
      "title": "🗄️ Database Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 501,
      "title": "DB Status",
      "type": "stat",
      "options": { "colorMode": "background" },
      "targets": [
        { "expr": "pg_up", "legendFormat": "PostgreSQL" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 502,
      "title": "Active Connections",
      "type": "stat",
      "targets": [
        { "expr": "pg_stat_activity_count{state=\"active\"}", "legendFormat": "Active" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "decbytes" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 503,
      "title": "Database Size",
      "type": "stat",
      "targets": [
        { "expr": "pg_database_size_bytes{datname=\"stock_streaming\"}", "legendFormat": "Size" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          },
          "max": 1, "min": 0
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 504,
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"stock_streaming\"} / (pg_stat_database_blks_hit{datname=\"stock_streaming\"} + pg_stat_database_blks_read{datname=\"stock_streaming\"} + 0.001)",
          "legendFormat": "Hit Ratio"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 505,
      "title": "Transactions/s",
      "type": "stat",
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"stock_streaming\"}[1m])", "legendFormat": "Commits/s" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 506,
      "title": "Deadlocks",
      "type": "stat",
      "targets": [
        { "expr": "increase(pg_stat_database_deadlocks{datname=\"stock_streaming\"}[1h])", "legendFormat": "Deadlocks" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 510,
      "title": "📊 Table Statistics (TimescaleDB SQL)",
      "type": "row"
    },
    {
      "datasource": "TimescaleDB",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "id": 511,
      "title": "📋 Hypertable Overview",
      "type": "table",
      "targets": [
        {
          "rawSql": "SELECT hypertable_name AS \"Table\", num_chunks AS \"Chunks\", pg_size_pretty(hypertable_size(format('%I.%I', hypertable_schema, hypertable_name)::regclass)) AS \"Total Size\", pg_size_pretty(total_bytes - index_bytes - toast_bytes) AS \"Table Size\", pg_size_pretty(index_bytes) AS \"Index Size\" FROM timescaledb_information.hypertables h, hypertable_detailed_size(format('%I.%I', h.hypertable_schema, h.hypertable_name)::regclass) WHERE hypertable_schema = 'public' ORDER BY total_bytes DESC;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Table" }, "properties": [{ "id": "custom.width", "value": 200 }] }
        ]
      }
    },
    {
      "datasource": "TimescaleDB",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 512,
      "title": "📈 Rows per Minute (stock_agg_second)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": { "drawStyle": "bars", "fillOpacity": 70 }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, count(*) AS value FROM stock_agg_second WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1;",
          "format": "time_series"
        }
      ]
    },
    {
      "datasource": "TimescaleDB",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 513,
      "title": "📈 Rows per Minute (stock_agg_minute)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "purple", "mode": "fixed" },
          "custom": { "drawStyle": "bars", "fillOpacity": 70 }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, count(*) AS value FROM stock_agg_minute WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1;",
          "format": "time_series"
        }
      ]
    },
    {
      "datasource": "TimescaleDB",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 514,
      "title": "📊 Top 10 Symbols by Row Count (Last Hour)",
      "type": "barchart",
      "options": { "orientation": "horizontal" },
      "targets": [
        {
          "rawSql": "SELECT symbol AS \"Symbol\", count(*) AS \"Rows\" FROM stock_agg_second WHERE time > NOW() - INTERVAL '1 hour' GROUP BY symbol ORDER BY count(*) DESC LIMIT 10;",
          "format": "table"
        }
      ]
    },
    {
      "datasource": "TimescaleDB",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 515,
      "title": "💀 Dead Letter Queue (Recent Entries)",
      "type": "table",
      "targets": [
        {
          "rawSql": "SELECT rejected_at AS \"Time\", symbol AS \"Symbol\", rejection_reason AS \"Reason\", open AS \"Open\", close AS \"Close\", batch_id AS \"Batch\" FROM dead_letter_queue WHERE rejected_at > NOW() - INTERVAL '1 hour' ORDER BY rejected_at DESC LIMIT 20;",
          "format": "table"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 520,
      "title": "🔧 PostgreSQL Performance",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "id": 521,
      "title": "Connections Over Time",
      "type": "timeseries",
      "targets": [
        { "expr": "pg_stat_activity_count{state=\"active\"}", "legendFormat": "Active" },
        { "expr": "pg_stat_activity_count{state=\"idle\"}", "legendFormat": "Idle" },
        { "expr": "pg_stat_activity_count{state=\"idle in transaction\"}", "legendFormat": "Idle in Tx" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "id": 522,
      "title": "Transactions per Second",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"stock_streaming\"}[1m])", "legendFormat": "Commits/s" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"stock_streaming\"}[1m])", "legendFormat": "Rollbacks/s" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["stock-platform", "timescaledb", "postgresql"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "🗄️ TimescaleDB",
  "uid": "timescaledb",
  "version": 1
}
