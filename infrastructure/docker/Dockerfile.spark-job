# ============================================================
# Stage 1: Spark-Dateien aus dem offiziellen Image holen
# ============================================================
FROM apache/spark:3.5.1 AS spark-base

# ============================================================
# Stage 2: Finales Image auf Python 3.11 + Bookworm Basis
# ============================================================
FROM python:3.11-slim-bookworm

LABEL maintainer="stock-platform"
LABEL component="spark-job"

USER root

# ─── Java 17 + curl + System-Dependencies ───
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    openjdk-17-jre-headless \
    libpq-dev \
    procps \
    && rm -rf /var/lib/apt/lists/*

# ─── Spark aus Stage 1 kopieren ───
ENV SPARK_HOME=/opt/spark
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
COPY --from=spark-base /opt/spark ${SPARK_HOME}

# Python dependencies
RUN pip3 install --no-cache-dir \
    psycopg2-binary==2.9.9 \
    python-dotenv==1.0.0 \
    pyyaml==6.0.1 \
    prometheus-client==0.19.0

# ─── Kafka + PostgreSQL JARs herunterladen ───
RUN curl -L -o ${SPARK_HOME}/jars/spark-sql-kafka-0-10_2.12-3.5.1.jar \
    https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.1/spark-sql-kafka-0-10_2.12-3.5.1.jar && \
    curl -L -o ${SPARK_HOME}/jars/kafka-clients-3.5.1.jar \
    https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.5.1/kafka-clients-3.5.1.jar && \
    curl -L -o ${SPARK_HOME}/jars/spark-token-provider-kafka-0-10_2.12-3.5.1.jar \
    https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.1/spark-token-provider-kafka-0-10_2.12-3.5.1.jar && \
    curl -L -o ${SPARK_HOME}/jars/commons-pool2-2.11.1.jar \
    https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar && \
    curl -L -o ${SPARK_HOME}/jars/postgresql-42.7.1.jar \
    https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.1/postgresql-42.7.1.jar

WORKDIR /app

# Application code
COPY config/ ./config/
COPY backend/spark_streaming/ ./backend/spark_streaming/
COPY backend/database/ ./backend/database/
COPY backend/__init__.py ./backend/

# Checkpoint directory
RUN mkdir -p /opt/spark-checkpoints && chmod 777 /opt/spark-checkpoints

# ─── Echten User für UID 1001 anlegen (löst UnixLoginModule + Ivy) ───
RUN groupadd -g 1001 spark && \
    useradd -u 1001 -g spark -d /home/spark -m -s /bin/bash spark && \
    mkdir -p /home/spark/.ivy2 && \
    chown -R spark:spark /home/spark && \
    chown -R spark:spark /opt/spark-checkpoints

# ─── Environment ───
ENV PYTHONUNBUFFERED=1
ENV HOME=/home/spark
ENV SPARK_USER=spark
ENV HADOOP_USER_NAME=spark
ENV PYTHONPATH=/app:${SPARK_HOME}/python:${SPARK_HOME}/python/lib/py4j-0.10.9.7-src.zip
ENV PATH="${SPARK_HOME}/bin:${PATH}"

EXPOSE 8090
EXPOSE 8091
EXPOSE 4040

USER spark

ENTRYPOINT ["python3", "-m", "backend.spark_streaming.entrypoint"]
CMD ["--job", "second"]
