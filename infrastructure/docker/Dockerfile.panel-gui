# ============================================================
# Panel GUI: Web-Dashboard
# ============================================================
FROM python:3.11-slim

LABEL maintainer="stock-platform"
LABEL component="panel-gui"

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
RUN pip install --no-cache-dir \
    panel==1.3.8 \
    bokeh==3.3.4 \
    holoviews==1.18.0 \
    param==2.0.1 \
    colorcet==3.0.1 \
    pandas==2.1.4 \
    numpy==1.26.2 \
    psycopg2-binary==2.9.9 \
    sqlalchemy==2.0.23 \
    confluent-kafka==2.3.0 \
    websockets==12.0 \
    python-dotenv==1.0.0 \
    pyyaml==6.0.1 \
    prometheus-client==0.19.0 \
    httpx==0.25.2

# Application code
COPY config/ ./config/
COPY backend/ ./backend/
COPY frontend/ ./frontend/
COPY data/ ./data/

# Static assets
COPY frontend/styles/custom.css ./frontend/styles/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import httpx; r = httpx.get('http://localhost:5006/app'); assert r.status_code == 200" || exit 1

# Panel Port
EXPOSE 5006

CMD ["panel", "serve", "frontend/app.py", \
     "--port", "5006", \
     "--address", "0.0.0.0", \
     "--allow-websocket-origin", "*", \
     "--num-procs", "1", \
     "--warm"]
